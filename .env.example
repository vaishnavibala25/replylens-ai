# Copy this file to .env and fill in your own values.
# ReplyLens AI uses an OpenAI-compatible chat completions API, so you can
# point it at OpenAI, OpenRouter, or any compatible provider/proxy.

# Your API key for the provider below.
LLM_API_KEY=

# Base URL for the OpenAI-compatible /chat/completions endpoint.
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model identifier as expected by your provider.
# Examples:
#   OpenAI:      gpt-4o-mini
#   OpenRouter:  openai/gpt-4o-mini  or  anthropic/claude-3.5-sonnet
LLM_MODEL=gpt-4o-mini

# If LLM_API_KEY is left blank, ReplyLens AI runs in Deterministic Demo Mode:
# retrieval, generation, objective checks, and six-dimension scoring run
# offline. Configure the key to use Live LLM Mode.
